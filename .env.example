# Reference list of settings. The app reads real environment variables;
# Render sets them from render.yaml. Locally, export them in your shell.

# development | production | test
APP_ENV=development

# Port for the local dev server (python wsgi.py). Render sets PORT itself.
PORT=5000

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# How long sign-in sessions last: e.g. 30m, 12h, 7d
JWT_EXPIRES_IN=7d

# Leave empty to use in-memory storage (data resets on restart).
# Example: postgresql://user:password@localhost:5432/punchlist
DATABASE_URL=

# Set to true when using Render's *external* database URL from your own machine.
DATABASE_SSL=false

# Create demo@punchlist.test / demo1234 with sample tasks on startup
SEED_DEMO=true

# Gunicorn workers when a database is configured (always 1 without one)
WEB_CONCURRENCY=2

LOG_LEVEL=INFO
